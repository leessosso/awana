rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 헬퍼 함수: 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 사용자 컬렉션
    match /users/{userId} {
      // 인증된 사용자는 모두 읽기/쓰기 가능 (권한 체크는 애플리케이션 레벨에서 처리)
      allow read, write: if isAuthenticated();
    }

    // 로그인 인덱스 컬렉션 (로그인 전 이름 -> 이메일 매핑용)
    match /loginIndex/{loginKey} {
      // 로그인 화면에서 문서 단건 조회(get)만 허용
      allow get: if true;
      // 목록 조회는 금지
      allow list: if false;
      // 생성/수정은 인증 사용자만 가능
      allow create, update, delete: if isAuthenticated();
    }

    // 교회 컬렉션
    match /churches/{churchId} {
      allow read, write: if isAuthenticated();
    }

    // 학생 컬렉션
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    // 출결 컬렉션
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }

    // 핸드북 진도 컬렉션
    match /handbook-progress/{progressId} {
      allow read, write: if isAuthenticated();
    }

    // SPARKS 핸드북 진도 컬렉션
    match /sparksHandbookProgress/{progressId} {
      // allow read, write: if isAuthenticated(); // 임시로 모든 권한 허용 (테스트용)
      allow read, write: if true;
    }

    // 게임시간 세션 컬렉션 (기존)
    match /gameTimeSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    // 게임시간 세션 컬렉션 쿼리 허용
    match /gameTimeSessions {
      allow list: if isAuthenticated();
    }

    // SPARKS 게임시간 세션 컬렉션
    match /sparksGameTimeSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    // SPARKS 게임시간 세션 컬렉션 쿼리 허용
    match /sparksGameTimeSessions {
      allow list: if isAuthenticated();
    }

    // T&T 게임시간 세션 컬렉션
    match /tntGameTimeSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    // T&T 게임시간 세션 컬렉션 쿼리 허용
    match /tntGameTimeSessions {
      allow list: if isAuthenticated();
    }
  }
}
